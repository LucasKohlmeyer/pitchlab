# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public demo account (read-only). Used server-side by the "Try the demo"
# button and by the seed script.
DEMO_EMAIL=demo@pitchlab.example
DEMO_PASSWORD=choose-a-demo-password

# Only needed to run `npm run seed`. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
